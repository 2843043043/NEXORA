# Copy this file to ".env" and fill in your real key
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the backend server runs on
PORT=3000

# Optional: real SMS delivery for mobile-number login OTPs.
# Without this set, OTPs are shown on-screen / logged to the console instead
# of being texted (demo mode) — the login flow still works either way.
# Get a free-trial key from https://www.fast2sms.com (Dashboard -> API Keys).
FAST2SMS_API_KEY=
